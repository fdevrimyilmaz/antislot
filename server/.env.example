PORT=3001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Apple StoreKit 2 JWS verification (optional in dev)
# In dev, if APPLE_ROOT_CERT_DIR contains no .cer files, the verifier is "off"
# and ALLOW_DEV_RECEIPT_BYPASS=true is required to accept Sandbox receipts.
APPLE_ROOT_CERT_DIR=certs/apple
APPLE_BUNDLE_ID=com.antislot.app
APPLE_ENV=sandbox
ALLOW_DEV_RECEIPT_BYPASS=true
